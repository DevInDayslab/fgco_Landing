# Razorpay — required for sponsorship checkout
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your_secret_key

# Backend API
# Local dev: use .env.local with http://localhost:3000
# Production builds: .env.production sets https://api.fgco.in
VITE_API_BASE_URL=http://localhost:3000

# Optional public key alias (server falls back to this if KEY_ID unset)
# VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
