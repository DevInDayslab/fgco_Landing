# Backend API
# Local dev: no env needed — Vite proxies /api to http://localhost:3000 automatically.
# Optional override: VITE_API_BASE_URL=http://localhost:3000
# Production builds: .env.production sets https://api.fgco.in
# VITE_API_BASE_URL=

# Razorpay keys are configured on the backend only (backend/.env).
# The checkout modal receives keyId from POST /api/.../create-order responses.
